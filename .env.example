# Required — your Google Tag Manager container ID. Without this, the app
# still runs and dataLayer pushes still show up in the DataLayer Viewer, but
# GTM itself is never loaded.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional / advanced — only set this if you're fronting GTM with your own
# server-side tagging endpoint (e.g. Google Tag Gateway via Cloudflare).
# Must end with a trailing slash. Leave unset to load GTM directly from
# googletagmanager.com, which works out of the box for everyone.
# NEXT_PUBLIC_GTM_SST_PATH=/your-sst-path/
